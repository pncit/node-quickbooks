<!DOCTYPE html>
<html lang="en">
  <head><meta charset="utf-8"><title>QuickBooks connection example</title></head>
  <body>
    <h1>QuickBooks connection example</h1>
    <% if (accounts === null) { %>
      <a href="/authorize">Connect to QuickBooks</a>
    <% } else { %>
      <h2>Accounts</h2>
      <ul><% accounts.forEach(function(account) { %><li><%= account.Name %></li><% }) %></ul>
      <a href="/start">Connect again</a>
    <% } %>
  </body>
</html>
